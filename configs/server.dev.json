{
    "env": "development",
    "logger" :{
        "level": "debug"
    },
    "jwt": {
        "private_key_path": "keys/jwt_private.pem",
        "public_key_path": "keys/jwt_public.pem",
        "access_token_ttl": "15m",
        "refresh_token_ttl": "168h",
        "issuer": "gophkeeper"
    },
    "grpc":{
        "host": "0.0.0.0",
        "port": 50054,
        "read_timeout": "15s",
        "write_timeout": "15s"
    },
    "http":{
        "host": "0.0.0.0",
        "port": 8080,
        "read_timeout": "15s",
        "write_timeout": "15s"
    },
    "db" : {
        "connection_string" : "postgresql://user:password@localhost:5432/gophkeeper?sslmode=disable",
        "max_conns": 25,
        "min_conns":5
    }
}